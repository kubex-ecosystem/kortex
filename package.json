{
  "name": "kortex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Rafael Mori <faelmori@gmail.com>",
  "description": "Kortex is a web application for managing MCP (Model Context Protocol) servers and devices, providing a user-friendly interface for configuration and monitoring.",
  "homepage": "https://rafa-mori.dev/kortex",
  "displayName": "Kortex",
  "icon": "https://raw.githubusercontent.com/rafa-mori/kortex/main/public/favicon.ico",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "enginesStrict": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rafa-mori/kortex.git"
  },
  "bugs": {
    "url": "https://github.com/rafa-mori/kortex/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rafa-mori"
  },
  "keywords": [
    "kortex",
    "mcp",
    "management",
    "web application",
    "configuration",
    "monitoring",
    "react"
  ],
  "scripts": {
    "prepare": "husky install",
    "precommit": "lint-staged",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "setup": "husky install && husky add .husky/pre-commit 'yarn lint-staged' && husky add .husky/pre-push 'yarn test'",
    "dev": "next dev",
    "build": "next build",
    "export": "next export",
    "start": "next start",
    "lint": "next lint",
    "test": "next test",
    "clean": "next clean",
    "clean:environment": "rm -rf ./node_modules ./yarn.lock ./package-lock.json ./.next ./out ./coverage || true",
    "build:old": "react-scripts build",
    "start:old": "react-scripts start",
    "test:old": "react-scripts test",
    "test:old-coverage": "react-scripts test --coverage",
    "test:old-watch": "react-scripts test --watchAll",
    "test:old-coverage-watch": "react-scripts test --coverage --watchAll",
    "test:old-e2e": "react-scripts test --env=jsdom",
    "test:old-e2e-watch": "react-scripts test --env=jsdom --watchAll",
    "test:old-coverage-e2e": "react-scripts test --env=jsdom --coverage"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "erro": "^2.1.0",
    "error": "^10.4.0",
    "framer-motion": "^12.23.6",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jszip": "^3.10.1",
    "lookatni-file-markers": "^1.1.0",
    "material-icons-react": "^1.0.4",
    "next": "^15.0.0",
    "next-i18next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.43.1",
    "react-i18next": "^14.0.0",
    "react-icons": "^4.6.0",
    "react-query": "^3.39.2",
    "react-router-dom": "^5.3.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^9.1.2",
    "react-use": "^17.4.0",
    "react-window": "^1.8.6",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-flow": "^7.27.1",
    "@types/history": "^4.7.11",
    "@types/node": "^20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^8",
    "eslint-config-next": "14.0.0",
    "husky": "^9.1.7",
    "lucide-react": "^0.525.0",
    "postcss": "^8",
    "react-aria-components": "^1.10.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint-staged",
      "pre-push": "yarn test",
      "commit-msg": "commitlint --edit $HUSKY_GIT_PARAMS",
      "post-merge": "yarn install",
      "post-checkout": "yarn install"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.yml": [
      "prettier --write"
    ],
    "*.yaml": [
      "prettier --write"
    ],
    "*.svg": [
      "prettier --write"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true,
    "tabWidth": 2,
    "printWidth": 80,
    "useTabs": false,
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "ignore",
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "jsxBracketSameLine": false,
    "embeddedLanguageFormatting": "auto",
    "requirePragma": false,
    "insertPragma": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "files": [
    "dist",
    "src",
    "public",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs"
  ]
}
